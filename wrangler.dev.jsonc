{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "turnip-tycoon-local",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Cloudflare counts attempts per key for a minute, in each of its locations. The database
  // never sees a client address.
  "ratelimits": [
    { "name": "CLIENT_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CREATION_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
  ],
  "secrets": { "required": [] },
  "vars": {
    "AUTH_MODE": "cookie",
    "FRONTEND_ORIGIN": "http://127.0.0.1:5173",
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://turnip:turnip-local-only@127.0.0.1:54329/turnip",
    },
  ],
}
