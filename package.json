{
  "name": "turnip-tycoon",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:app": "vite --host 127.0.0.1",
    "db:local": "tsx scripts/local-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:prod": "tsx --env-file=.env.production scripts/migrate.ts",
    "icons:generate": "node scripts/generate-icons.mjs",
    "fonts:subset": "tsx scripts/subset-fonts.ts",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui check sync",
    "typegen": "wrangler types --config wrangler.jsonc --strict-vars false",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "build": "pnpm run typecheck && vite build",
    "build:pages": "pnpm run typecheck && vite build --mode pages",
    "preview": "vite preview --host 127.0.0.1",
    "preview:pages": "vite preview --mode pages --host localhost --port 4174 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "pnpm run lint && pnpm run i18n:check && pnpm run build && pnpm test",
    "deploy:check": "wrangler deploy --config wrangler.jsonc --dry-run --outdir dist/api",
    "deploy:api": "wrangler deploy --config wrangler.jsonc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@lingui/core": "^6.9.1",
    "@lingui/react": "^6.9.1",
    "dexie": "^4.4.6",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "lucide-react": "^1.52.0",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "7z-wasm": "1.2.0",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "^6.9.1",
    "@lingui/format-po": "^6.9.1",
    "@lingui/native-tools": "^0.1.6",
    "@lingui/vite-plugin": "^6.9.1",
    "@messageformat/parser": "^5.1.1",
    "@playwright/cli": "^0.1.22",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "harfbuzzjs": "1.6.3",
    "prettier": "^3.9.9",
    "sharp": "0.35.4",
    "subset-font": "2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
