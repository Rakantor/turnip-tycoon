{
  "name": "Turnip Tycoon",
  "short_name": "Turnip Tycoon",
  "description": "Enter weekly turnip prices, explore forecasts, and compare prices with friends.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#f4ebd3",
  "background_color": "#f4ebd3",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://turniptycoon.app/manifest.webmanifest"
    }
  ],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
