# Production migrations only: read by `pnpm db:migrate:prod`, never by `pnpm dev`.
# Copy this to .env.production. Never use a VITE_ prefix for credentials.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/path/to/supabase-ca.crt
