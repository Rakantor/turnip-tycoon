# Copy to .env next to compose.yaml, replace every CHANGE_ME, and keep it private (chmod 600).
# Variables are described at https://docs.weblate.org/en/latest/admin/install/docker.html

# How HTTPS reaches Weblate (README.md, step 6). Keep compose.yaml and add one of
# compose.caddy.yaml, compose.localhost.yaml or compose.proxy-network.yaml.
COMPOSE_FILE=compose.yaml:compose.caddy.yaml
# compose.proxy-network.yaml only: the Docker network your proxy container is on.
PROXY_NETWORK=
# compose.localhost.yaml only: the loopback port your proxy forwards to.
WEBLATE_HOST_PORT=8080

# Site: the domain that points at this server, e.g. translate.example.com, twice.
WEBLATE_SITE_DOMAIN=CHANGE_ME
WEBLATE_ALLOWED_HOSTS=CHANGE_ME
WEBLATE_SITE_TITLE=Turnip Tycoon Translations
WEBLATE_DEBUG=0
WEBLATE_LOGLEVEL=INFO

# First admin account; it signs in as "admin". Weblate resets this password on every start while
# it is set, so remove the line after the first sign-in (README.md, step 8).
WEBLATE_ADMIN_NAME=CHANGE_ME
WEBLATE_ADMIN_EMAIL=CHANGE_ME
WEBLATE_ADMIN_PASSWORD=CHANGE_ME

# Every HTTPS option above ends in a proxy that sets X-Forwarded-For and X-Forwarded-Proto, and
# none publishes Weblate's port to the internet.
WEBLATE_ENABLE_HTTPS=1
WEBLATE_IP_PROXY_HEADER=HTTP_X_FORWARDED_FOR
WEBLATE_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Sized for a small server (2 cores, 4 GB): fewer worker processes and one Celery process for all
# queues. Remove both lines on a server with 8 GB or more.
WEBLATE_WORKERS=2
CELERY_WORKER_MODE=single

# Anyone can sign up by email. Fill in a GitHub OAuth app (README.md, step 4) to offer GitHub
# sign-in too; leave both empty to skip it.
WEBLATE_REGISTRATION_OPEN=1
WEBLATE_SOCIAL_AUTH_GITHUB_KEY=
WEBLATE_SOCIAL_AUTH_GITHUB_SECRET=

# Outgoing mail through any SMTP service. Port 587 with STARTTLS works almost everywhere; several
# cloud providers block outgoing connections to ports 25 and 465. For implicit TLS on 465 instead,
# set USE_TLS=0 and USE_SSL=1.
WEBLATE_EMAIL_HOST=CHANGE_ME
WEBLATE_EMAIL_PORT=587
WEBLATE_EMAIL_USE_TLS=1
WEBLATE_EMAIL_USE_SSL=0
WEBLATE_EMAIL_HOST_USER=CHANGE_ME
WEBLATE_EMAIL_HOST_PASSWORD=CHANGE_ME
# The sender, an address on a domain your mail service is set up to send for.
WEBLATE_SERVER_EMAIL=CHANGE_ME
WEBLATE_DEFAULT_FROM_EMAIL=CHANGE_ME

# Pull requests come from the bot account's fork, which has no write access to the repository
# (README.md, step 5).
WEBLATE_GITHUB_USERNAME=CHANGE_ME
WEBLATE_GITHUB_TOKEN=CHANGE_ME
WEBLATE_GITHUB_HOST=api.github.com

# Database and cache, reached over Weblate's own Compose network only. Generate the password with
# `openssl rand -hex 24`.
POSTGRES_USER=weblate
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=weblate
POSTGRES_HOST=database
REDIS_HOST=cache
REDIS_PORT=6379
