{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "turnip-tycoon",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "api.turniptycoon.app", "custom_domain": true }],
  // Every hour, delete expired pairing codes and shared friend links, and abandoned profiles.
  "triggers": { "crons": ["23 * * * *"] },
  // Cloudflare counts attempts per key for a minute, in each of its locations. The database
  // never sees a client address.
  "ratelimits": [
    { "name": "CLIENT_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CREATION_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
  ],
  "secrets": { "required": [] },
  "vars": {
    "AUTH_MODE": "bearer",
    "FRONTEND_ORIGIN": "https://turniptycoon.app",
  },
  // Keep only the app's own error logs; per-request invocation logs would record every request.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5b3c343418a845358bce4ca55d10fc4e",
      "localConnectionString": "postgresql://turnip:turnip-local-only@127.0.0.1:54329/turnip",
    },
  ],
}
